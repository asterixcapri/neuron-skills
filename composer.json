{
    "name": "asterixcapri/neuron-skills",
    "description": "Agent Skills toolkit with pluggable storage for Neuron AI.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "neuron-core/neuron-ai": "^3.16.13",
        "symfony/polyfill-intl-normalizer": "^1.31",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "NeuronAI\\Skills\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronAI\\Skills\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
