{
    "name": "neuron-core/agent-skills",
    "description": "Agent Skills toolkit with pluggable storage for Neuron AI.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "neuron-core/neuron-ai": "^4.0",
        "symfony/polyfill-intl-normalizer": "^1.31",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "symfony/dotenv": "^6.4"
    },
    "suggest": {
        "ext-pdo": "Required to load skills from a SQL database with DatabaseSkillStorage."
    },
    "autoload": {
        "psr-4": {
            "NeuronAI\\AgentSkills\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronAI\\AgentSkills\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
